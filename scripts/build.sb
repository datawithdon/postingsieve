(version 1)
; Third-party build tools run inside this. No network, no writes outside the project and
; temp folders, and no reads of credentials or personal folders.
(allow default)
(deny network*)
(deny file-write*)
(allow file-write*
  (subpath (param "PROJECT"))
  (subpath "/private/tmp")
  (subpath "/private/var/folders")
  (subpath "/tmp")
  (literal "/dev/null")
  (literal "/dev/tty")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (regex #"^/dev/fd/")
  (regex #"^/dev/ttys"))
(deny file-read*
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.gnupg"))
  (subpath (string-append (param "HOME") "/.config"))
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/.codex"))
  (subpath (string-append (param "HOME") "/.gemini"))
  (literal (string-append (param "HOME") "/.npmrc"))
  (literal (string-append (param "HOME") "/.netrc"))
  (literal (string-append (param "HOME") "/.zsh_history"))
  (literal (string-append (param "HOME") "/.bash_history"))
  (subpath (string-append (param "HOME") "/Documents"))
  (subpath (string-append (param "HOME") "/Desktop"))
  (subpath (string-append (param "HOME") "/Downloads"))
  (subpath (string-append (param "HOME") "/Pictures"))
  (subpath (string-append (param "HOME") "/Movies"))
  (subpath (string-append (param "HOME") "/Music"))
  (subpath (string-append (param "HOME") "/daily-app-agent"))
  (subpath (string-append (param "HOME") "/Library/Keychains"))
  (subpath (string-append (param "HOME") "/Library/Cookies"))
  (subpath (string-append (param "HOME") "/Library/Mail"))
  (subpath (string-append (param "HOME") "/Library/Messages"))
  (subpath (string-append (param "HOME") "/Library/Application Support")))
