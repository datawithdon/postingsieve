{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome", "vite/client", "node"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true, "resolveJsonModule": true
  },
  "include": ["src", "tests", "*.ts"]
}
